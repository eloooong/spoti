# Copy this file to ".env" and fill in your own values.
# You get CLIENT_ID and CLIENT_SECRET from https://developer.spotify.com/dashboard

SPOTIFY_CLIENT_ID=paste_your_client_id_here
SPOTIFY_CLIENT_SECRET=paste_your_client_secret_here

# This MUST exactly match a Redirect URI you added in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# A random string to protect the login flow from tampering (any text works)
STATE_SECRET=change_this_to_any_random_string

# Port the server runs on locally. Hosting providers usually set this for you.
PORT=8888

# Optional — only needed for the AI features (Taste Profile, Recap, and
# the "Ask about your stats" chat). Get a free key from https://console.groq.com.
# Leave blank/unset to disable those features — the rest of the site works fine
# without it, those panels just won't appear.
GROQ_API_KEY=

# Optional override for the Groq model. Defaults to openai/gpt-oss-20b.
# Groq retires models periodically (see https://console.groq.com/docs/deprecations),
# so if the default ever stops working, set the new model ID here instead of
# editing code.
GROQ_MODEL=

# PostgreSQL connection string for persistent sessions (survives restarts).
# On Render: add a PostgreSQL add-on and this is set automatically.
# Without this, sessions are stored in memory and lost on restart.
DATABASE_URL=

# Restrict CORS to your production domain (e.g. https://your-app.onrender.com).
# Leave blank/unset for local dev (allows all origins).
ALLOWED_ORIGIN=

# Required on Vercel: a long random secret for encrypted, HttpOnly session
# cookies and OAuth state. Reuse the existing production STATE_SECRET.
# Without DATABASE_URL, this avoids relying on serverless process memory.
STATE_SECRET=
